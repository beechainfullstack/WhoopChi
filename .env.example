# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"

# From https://developer.whoop.com — create an app with redirect URL
# http://localhost:3000/api/auth/whoop/callback
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
WHOOP_REDIRECT_URI="http://localhost:3000/api/auth/whoop/callback"

# Webhook signature secret (WHOOP dashboard -> Webhooks). Leave blank to skip verification in dev.
WHOOP_WEBHOOK_SECRET=""

# Random string used to sign the session cookie
SESSION_SECRET="change-me"
